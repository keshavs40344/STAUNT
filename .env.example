# STAUNT Sovereign Search Engine — Environment Configuration Specification
# Copy to .env for local development overrides (never commit .env)

# Core Server Configuration
PORT=5000
FLASK_ENV=production
SECRET_KEY=

# Production Domain & URL Resolution
STAUNT_PUBLIC_URL=
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,app://.

# Optional AI & External Search Providers
GROQ_API_KEY=
TAVILY_API_KEY=
